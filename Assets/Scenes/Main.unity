  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'My friend <color=#1A6800>(Maeve)<color=#000000>, works at an illegal <color=#0026A9>(bar)<color=#000000>.
    Has red hair and piercing eyes.

    She''s an Irish mafia member who''s build
    up one''s track record.'
